&reserved_memory {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	qcn9224_0_mem: qcn9224_0_mem {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
#ifndef __WLAN_LITE_PROFILE__
		size = <0x0 0x5800000>;
#else
		size = <0x0 0x2000000>;
#endif
	};

	qcn9224_1_mem: qcn9224_1_mem {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
#ifndef __WLAN_LITE_PROFILE__
		size = <0x0 0x5800000>;
#else
		size = <0x0 0x2000000>;
#endif

	};

	qcn9224_2_mem: qcn9224_2_mem {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
#ifndef __WLAN_LITE_PROFILE__
		size = <0x0 0x5800000>;
#else
		size = <0x0 0x2000000>;
#endif

	};

	mlo_global_mem0: mlo_global_mem_0@0 {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		iova_base = <0xBEC00000>;
		dma-coherent;
		reusable;
		alignment = <0x0 0x400000>;
#ifndef __WLAN_LITE_PROFILE__
		size = <0x0 0x1400000>;
#else
		size = <0x0 0x1000000>;
#endif

	};
};

&soc {
	wifi0: qcom,cnss-qcn9224@a0000000 {
			compatible  = "qcom,cnss-qcn9224";
			reg = <0x0 0xc0000000 0x0 0x10000>;
			reg-names = "smmu_iova_ipa";
			memory-region = <&mlo_global_mem0>;
			qcom,wlan-ramdump-dynamic = <0x600000>;
			node_id = <0x0>;
			qca,auto-restart;
			interrupt-bmap = <0x100503>;
			board_id = <0x02>;
			probe-order = <0x2>;
			qcom,wlan-rc-num = <0x0>;
#ifdef __WLAN_LITE_PROFILE__
			tgt-mem-mode = <0x2>;
#endif
			status = "ok";
	};

	wifi1: qcom,cnss-qcn9224@b0000000 {
			compatible  = "qcom,cnss-qcn9224";
			reg = <0x0 0xc0020000 0x0 0x10000>;
			reg-names = "smmu_iova_ipa";
			memory-region = <&mlo_global_mem0>;
			qcom,wlan-ramdump-dynamic = <0x600000>;
			node_id = <0x1>;
			qca,auto-restart;
			interrupt-bmap = <0x100503>;
			board_id = <0x04>;
			probe-order = <0x1>;
			qcom,wlan-rc-num = <0x1>;
#ifdef __WLAN_LITE_PROFILE__
			tgt-mem-mode = <0x2>;
#endif
			status = "ok";
	};

	wifi2: qcom,cnss-qcn9224@c0000000 {
			compatible  = "qcom,cnss-qcn9224";
			reg = <0x0 0xc0040000 0x0 0x10000>;
			reg-names = "smmu_iova_ipa";
			memory-region = <&mlo_global_mem0>;
			qcom,wlan-ramdump-dynamic = <0x600000>;
			node_id = <0x2>;
			qca,auto-restart;
			interrupt-bmap = <0x100503>;
			board_id = <0x01>;
			probe-order = <0x3>;
			qcom,wlan-rc-num = <0x2>;
#ifdef __WLAN_LITE_PROFILE__
			tgt-mem-mode = <0x2>;
#endif
			status = "ok";
	};

	pinn_wkk0_vreg: pinn_wkk0_vreg {
			compatible = "qti-regulator-fixed";
			regulator-name = "pinn_wkk0_vreg";
			gpio = <&tlmm 82 GPIO_ACTIVE_HIGH>;
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			enable-active-high;
			regulator-enable-ramp-delay = <200000>;
	};

	pinn_wkk1_vreg: pinn_wkk1_vreg {
			compatible = "qti-regulator-fixed";
			regulator-name = "pinn_wkk1_vreg";
			gpio = <&tlmm 17 GPIO_ACTIVE_HIGH>;
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			enable-active-high;
			regulator-enable-ramp-delay = <200000>;
	};

	pinn_wkk2_vreg: pinn_wkk2_vreg {
			compatible = "qti-regulator-fixed";
			regulator-name = "pinn_wkk2_vreg";
			gpio = <&tlmm 76 GPIO_ACTIVE_HIGH>;
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			enable-active-high;
			regulator-enable-ramp-delay = <200000>;
	};

	cnss_pci_iommu_group0: cnss_pci_iommu_group {
			qcom,iommu-msi-size = <0x1000>;
			qcom,iommu-dma-addr-pool = <0x0 0x70000000 0x0 0x4EC00000>;
#ifdef __WLAN_UD__
			qcom,iommu-dma = "bypass";
#else
			qcom,iommu-dma = "fastmap";
#endif
			dma-coherent;
			qcom,iommu-faults = "stall-disable", "HUPCF", "no-CFRE",
					    "non-fatal";
	};

};

#ifdef __WLAN_UD__
&wsi {
	id = <0>;
	num_chip = <3>;
	status = "okay";
	chip_info = <0 2 1 2>,
		    <1 2 2 0>,
		    <2 2 0 1>;
	status = "okay";
};

#endif

&pcie0_rp {
	reg = <0 0 0 0 0>;
	#address-cells = <5>;
	#size-cells = <0>;
#ifdef __WLAN_UD__
	wifi@0 {
		reg = <0 0 0 0 0>;
		qcom,iommu-group = <&cnss_pci_iommu_group0>;
		memory-region = <&qcn9224_0_mem>, <&mlo_global_mem0>;
		#address-cells = <1>;
		#size-cells = <1>;
		dma-coherent;
		memory-region-names = "host-ddr-mem", "mlo-global-mem";
		qcom,board_id = <0x2>;
		qcom,wsi_index = <1>;
		qcom,wsi = <&wsi>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				wifi1_wsi_tx: endpoint {
					remote-endpoint = <&wifi2_wsi_rx>;
				};
			};

			port@1 {
				reg = <1>;

				wifi1_wsi_rx: endpoint {
					remote-endpoint = <&wifi3_wsi_tx>;
				};
			};
		};
	};

#else
	cnss_pci0: cnss_pci0 {
		reg = <0 0 0 0 0>;
		qcom,iommu-group = <&cnss_pci_iommu_group0>;
		memory-region = <&qcn9224_0_mem>;
		#address-cells = <1>;
		#size-cells = <1>;
		dma-coherent;
	};

#endif
};

