&pcie2_rp {
	reg = <0 0 0 0 0>;
	#address-cells = <5>;
	#size-cells = <0>;
#ifdef __WLAN_UD__
	wifi@2 {
		reg = <0 0 0 0 0>;
		qcom,iommu-group = <&cnss_pci_iommu_group0>;
		memory-region = <&qcn9224_2_mem>, <&mlo_global_mem0>;
		#address-cells = <1>;
		#size-cells = <1>;
		dma-coherent;
		memory-region-names = "host-ddr-mem", "mlo-global-mem";
		qcom,board_id = <0x1>;
		qcom,wsi = <&wsi>;
		qcom,wsi_index = <2>;
		qcom,pta-num = <0>;
		qcom,coex-mode = <0x2>;
		qcom,bt-active-time = <0x18>;
		qcom,bt-priority-time = <0x12>;
		qcom,coex-algo = <0x2>;
		qcom,pta-priority = <0x80800505>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				wifi3_wsi_tx: endpoint {
					remote-endpoint = <&wifi1_wsi_rx>;
				};
			};

			port@1 {
				reg = <1>;

				wifi3_wsi_rx: endpoint {
					remote-endpoint = <&wifi2_wsi_tx>;
				};
			};
		};
	};

#else
	cnss_pci2: cnss_pci2 {
		reg = <0 0 0 0 0>;
		qcom,iommu-group = <&cnss_pci_iommu_group0>;
		memory-region = <&qcn9224_2_mem>;
		#address-cells = <1>;
		#size-cells = <1>;
		dma-coherent;
	};

#endif
};

&pcie2 {
	qcom,no-l0s-supported;
	qcom,no-l1-supported;
	qcom,no-l1ss-supported;
	qcom,no-aux-clk-sync;
