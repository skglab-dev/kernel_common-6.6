&pcie1_rp {
	reg = <0 0 0 0 0>;
	#address-cells = <5>;
	#size-cells = <0>;
#ifdef __WLAN_UD__
	wifi@1 {
		reg = <0 0 0 0 0>;
		qcom,iommu-group = <&cnss_pci_iommu_group0>;
		memory-region = <&qcn9224_1_mem>, <&mlo_global_mem0>;
		#address-cells = <1>;
		#size-cells = <1>;
		dma-coherent;
		memory-region-names = "host-ddr-mem", "mlo-global-mem";
		qcom,board_id = <0x4>;
		qcom,wsi = <&wsi>;
		qcom,wsi_index = <0>;
		qcom,wsi-controller;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				wifi2_wsi_tx: endpoint {
					remote-endpoint = <&wifi3_wsi_rx>;
				};
			};

			port@1 {
				reg = <1>;

				wifi2_wsi_rx: endpoint {
					remote-endpoint = <&wifi1_wsi_tx>;
				};
			};
		};
	};

#else
	cnss_pci1: cnss_pci1 {
		reg = <0 0 0 0 0>;
		qcom,iommu-group = <&cnss_pci_iommu_group0>;
		memory-region = <&qcn9224_1_mem>;
		#address-cells = <1>;
		#size-cells = <1>;
		dma-coherent;
	};

#endif
};

